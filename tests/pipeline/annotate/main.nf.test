nextflow_pipeline {

    name "Test pipeline - VEP annotation"
    script "main.nf"

    tag "pipeline"
    tag "pipeline_annotate"

    options "-stub"

    test("pipeline - exomedepth (CRAM input) + annotate") {

        when {
            params {
                outdir = "$outputDir"
                exomedepth = true
                annotate = true
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromPath(params.outdir, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromPath(params.outdir, ignore: ['exomedepth/cnv_call*/*.{vcf*,html}'], ignoreFile: 'tests/.nftignore')
            // stable_path: VCF files
            def stable_path_vcf = getAllFilesFromPath(params.outdir, include: ['exomedepth/cnv_call*/*.vcf.gz'])
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we tests pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/exomecnv_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    getRelativePath(stable_name, outputDir),
                    // All files with stable contents
                    stable_path,
                    // VCF files with stable contents
                    stable_path_vcf.collect { ["VCF", path(it.toString()).vcf.variantsMD5] }
                ).match() }
            )
        }
    }
    test("pipeline - exomedepth (BED input) + annotate") {

        when {
            params {
                outdir = "$outputDir"
                exomedepth = true
                annotate = true
                input = "${projectDir}/assets/samplesheet_bed.csv"
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromPath(params.outdir, ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromPath(params.outdir, ignore: ['exomedepth/cnv_call*/*.{vcf*,html}'], ignoreFile: 'tests/.nftignore')
            // stable_path: VCF files
            def stable_path_vcf = getAllFilesFromPath(params.outdir, include: ['exomedepth/cnv_call*/*.vcf.gz'])
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we tests pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/exomecnv_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    getRelativePath(stable_name, outputDir),
                    // All files with stable contents
                    stable_path,
                    // VCF files with stable contents
                    stable_path_vcf.collect { ["VCF", path(it.toString()).vcf.variantsMD5] }
                ).match() }
            )
        }
    }
}
