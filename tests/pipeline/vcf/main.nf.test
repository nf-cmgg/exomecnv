nextflow_pipeline {

    name "Test pipeline - VCF input"
    script "main.nf"

    tag "pipeline"
    tag "pipeline_vcf"

    options "-stub"

    test("pipeline - VCF input") {

        when {
            params {
                outdir = "$outputDir"
                exomedepth = true
                input = "$projectDir/assets/samplesheet_vcf.csv"
                annotate = true
            }
        }

        then {
            // stable_name: All files + folders in ${params.outdir}/ with a stable name
            def stable_name = getAllFilesFromPath(params.outdir, includeDir: true, include: ['*', '**/*'], ignore: ['pipeline_info/*.{html,json,txt}'])
            // stable_path: All files in ${params.outdir}/ with stable content
            def stable_path = getAllFilesFromPath(params.outdir, includeDir: false, include: ['*', '**/*'], ignoreFile: 'tests/.nftignore')
            // stable_path: VEP VCF files
            def stable_path_vcf = getAllFilesFromPath(params.outdir, includeDir: false, include: ['exomedepth/**/*.vcf.gz}'], ignore: ['*', '**/*'])
            assertAll(
                { assert workflow.success},
                { assert snapshot(
                    // Number of successful tasks
                    workflow.trace.succeeded().size(),
                    // pipeline versions.yml file for multiqc from which Nextflow version is removed because we tests pipelines on multiple Nextflow versions
                    removeNextflowVersion("$outputDir/pipeline_info/exomecnv_software_mqc_versions.yml"),
                    // All stable path name, with a relative path
                    getRelativePath(stable_name, outputDir),
                    // All files with stable contents
                    stable_path,
                    // VCF files with stable contents
                    stable_path_vcf.collect { ["VCF", path(it.toString()).vcf.variantsMD5] }
                ).match() }
            )
        }
    }
}
