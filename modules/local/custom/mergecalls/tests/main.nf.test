nextflow_process {

    name "Test Process CUSTOM_MERGECALLS"
    script "../main.nf"
    process "CUSTOM_MERGECALLS"

    tag "modules"
    tag "modules_local"
    tag "mergecalls"

    test("homo_sapiens - calls") {

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id: 'Sample1', chromosome:"merged", samples:["Sample1", "Sample2", "Sample3", "Sample4", "Sample5"], families:["Fam1", "Fam2", "Fam3", "Fam4", "Fam5"] ],
                    [
                        file(params.calls_autosomal, checkIfExists:true),
                        file(params.calls_chrx, checkIfExists:true)
                    ]
                ])
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

    test("homo_sapiens - calls - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = Channel.of([
                    [ id: 'Sample1', chromosome:"merged", samples:["Sample1", "Sample2", "Sample3", "Sample4", "Sample5"], families:["Fam1", "Fam2", "Fam3", "Fam4", "Fam5"] ],
                    [
                        file(params.calls_autosomal, checkIfExists:true),
                        file(params.calls_chrx, checkIfExists:true)
                    ]
                ])
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
