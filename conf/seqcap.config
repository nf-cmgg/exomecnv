/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running the pipeline on the CMGG infrastructure
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    exomedepth = true
    annotate   = true
    // default region of interest
    roi        = "${params.igenomes_base}/Hsapiens/GRCh38/regions/SeqCap/FamCanc_v3/FamCanc_v3_cds_e105_cnv_target_sorted_merged.bed"
}
